[Unit]
Description=Flask API Relay
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/all_api_in_one
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/all_api_in_one/.venv/bin/python /opt/all_api_in_one/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
